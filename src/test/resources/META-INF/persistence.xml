<!--  Unidade de persistência SÓ para testes: banco H2 em memória, sem WildFly e sem PostgreSQL  -->
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd" version="2.1">
    <persistence-unit name="rhTestPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.empresa.rh.model.Administrador</class>
        <class>com.empresa.rh.model.Cargo</class>
        <class>com.empresa.rh.model.Departamento</class>
        <class>com.empresa.rh.model.Endereco</class>
        <class>com.empresa.rh.model.Funcionario</class>
        <class>com.empresa.rh.model.HistoricoSalarial</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <!--  Não há provedor de Bean Validation no teste de DAO; a validação já é testada nos Services  -->
        <validation-mode>NONE</validation-mode>
        <properties>
            <property name="javax.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:h2:mem:rhtest;MODE=PostgreSQL;DB_CLOSE_DELAY=-1"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <!--  Cria as tabelas a partir das ENTIDADES e apaga ao fechar  -->
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
        </properties>
    </persistence-unit>
</persistence>